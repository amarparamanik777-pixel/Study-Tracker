{
  "rules": {
    ".read": false,
    ".write": false,
    "codes": {
      "$c": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString() && $c.matches(/^[A-Z2-9]{6}$/)"
      }
    },
    "users": {
      "$u": {
        ".read": "auth != null && auth.uid === $u",
        "code": { ".write": "auth != null && auth.uid === $u" },
        "grp": {
          ".write": "auth != null && ((auth.uid === $u && (newData.val() === null || (!data.exists() && !root.child('groups').child(newData.val()).exists()))) || (!data.exists() && root.child('reqs').child(auth.uid).child($u).exists()))"
        }
      }
    },
    "reqs": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)",
          ".validate": "newData.hasChildren(['n','e','t'])"
        }
      }
    },
    "groups": {
      "$g": {
        "m": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('grp').val() === $g",
          "$u": {
            ".write": "auth != null && auth.uid === $u && root.child('users').child(auth.uid).child('grp').val() === $g",
            ".validate": "newData.hasChildren(['n','u'])"
          }
        }
      }
    },
    "lock": {
      "u": {
        ".read": "auth != null && auth.token.email === 'admin@study-log.app'",
        ".write": "auth != null && auth.token.email === 'admin@study-log.app'",
        "$uid": {
          "reg": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['n','c','m','k','o','t'])",
            "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "c": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "m": { ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 20" },
            "k": { ".validate": "newData.isString() && (newData.val() === 'y' || newData.val() === 'n')" },
            "x": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "o": { ".validate": "newData.val() === true" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "ask": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          },
          "seen": {
            ".write": "auth != null && auth.uid === $uid",
            "a": { ".validate": "newData.isNumber()" },
            "l": { ".validate": "newData.isNumber()" },
            "k": { ".validate": "newData.isNumber()" },
            "n": { ".validate": "newData.isNumber()" },
            "w": { ".validate": "newData.isString() && (newData.val() === 'f' || newData.val() === 'd' || newData.val() === 'g' || newData.val() === 'o')" },
            "$other": { ".validate": false }
          },
          "done": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "c": {
        ".read": "auth != null && auth.token.email === 'admin@study-log.app'",
        ".write": "auth != null && auth.token.email === 'admin@study-log.app'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "pw": {
            ".validate": "newData.hasChildren(['s','h','i'])",
            "s": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64" },
            "h": { ".validate": "newData.isString() && newData.val().length === 64" },
            "i": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 1000000" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "pwu": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.isNumber()"
          },
          "b": {
            ".validate": "newData.hasChildren(['t','d'])",
            "t": { ".validate": "newData.isNumber()" },
            "d": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 31536000000" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "s": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64" },
            "h": { ".validate": "newData.isString() && newData.val().length === 64" },
            "i": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 1000000" },
            "$other": { ".validate": false }
          },
          "ir": { ".validate": "newData.isNumber()" },
          "fm": { ".validate": "newData.isNumber()" },
          "md": {
            "$mid": {
              ".validate": "newData.hasChildren(['t','k','st','ti','m']) && (newData.child('k').val() !== 'p' || newData.hasChildren(['s','h','i']))",
              "t": { ".validate": "newData.isNumber()" },
              "k": { ".validate": "newData.isString() && (newData.val() === 'i' || newData.val() === 'p')" },
              "st": { ".validate": "newData.isString() && (newData.val() === 'i' || newData.val() === 'w' || newData.val() === 'g' || newData.val() === 'a')" },
              "ti": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
              "m": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 600" },
              "s": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64" },
              "h": { ".validate": "newData.isString() && newData.val().length === 64" },
              "i": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 1000000" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "ap": {
        ".read": "auth != null && auth.token.email === 'admin@study-log.app'",
        ".write": "auth != null && auth.token.email === 'admin@study-log.app'",
        "$k": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64" }
      },
      "ma": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'admin@study-log.app'",
        "$mid": {
          ".validate": "newData.hasChildren(['t','k','st','ti','m']) && (newData.child('k').val() !== 'p' || newData.hasChildren(['s','h','i']))",
          "t": { ".validate": "newData.isNumber()" },
          "k": { ".validate": "newData.isString() && (newData.val() === 'i' || newData.val() === 'p')" },
          "st": { ".validate": "newData.isString() && (newData.val() === 'i' || newData.val() === 'w' || newData.val() === 'g' || newData.val() === 'a')" },
          "ti": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "m": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 600" },
          "s": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64" },
          "h": { ".validate": "newData.isString() && newData.val().length === 64" },
          "i": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 1000000" },
          "$other": { ".validate": false }
        }
      },
      "ak": {
        ".read": "auth != null && auth.token.email === 'admin@study-log.app'",
        ".write": "auth != null && auth.token.email === 'admin@study-log.app'",
        "$mid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('lock').child('ma').child($mid).exists() || root.child('lock').child('c').child($uid).child('md').child($mid).exists())",
            ".validate": "newData.isNumber()"
          }
        }
      },
      "ins": {
        ".read": "auth != null && auth.token.email === 'admin@study-log.app'",
        ".write": "auth != null && auth.token.email === 'admin@study-log.app'",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['t','j'])",
          "t": { ".validate": "newData.isNumber()" },
          "r": { ".validate": "newData.isNumber()" },
          "j": { ".validate": "newData.isString() && newData.val().length <= 950000" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
